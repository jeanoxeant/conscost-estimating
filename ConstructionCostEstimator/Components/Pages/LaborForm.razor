@using ConstructionCostEstimator.Models
@using ConstructionCostEstimator.Services

<EditForm Model="LaborModel" OnValidSubmit="Save" FormName="LaborForm" id="labor-form">

    <DataAnnotationsValidator />

    <ValidationSummary />

    <div class="row">

        <div class="col-md-3 mb-3">
            <label class="form-label">Description</label>
            <InputText class="form-control"
                       @bind-Value="LaborModel.Description" />
            <ValidationMessage For="@(() => LaborModel.Description)" class="text-danger" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Workers</label>
            <InputNumber class="form-control"
                         @bind-Value="LaborModel.Workers" />
            <ValidationMessage For="@(() => LaborModel.Workers)" class="text-danger" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Hours</label>
            <InputText class="form-control"
                       @bind-Value="hoursText"
                       onkeydown="if(event.key === 'Enter') event.preventDefault();" />
            <ValidationMessage For="@(() => LaborModel.Hours)" class="text-danger" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Hourly Rate</label>
            <InputText class="form-control"
                       @bind-Value="hourlyRateText"
                       onkeydown="if(event.key === 'Enter') event.preventDefault();" />
            <ValidationMessage For="@(() => LaborModel.HourlyRate)" class="text-danger" />
        </div>

        <div class="col-md-2 d-grid">

            <label>&nbsp;</label>

            <button class="btn btn-success" type="button" @onclick="Save">
                @(LaborModel.Id == 0 ? "Add Labor" : "Save Changes")
            </button>

        </div>

    </div>

</EditForm>

@code{

    [Parameter]
    public Labor LaborModel { get; set; } = new();

    [Parameter]
    public EventCallback<Labor> OnSave { get; set; }

    private string hourlyRateText = string.Empty;
    private string hoursText = string.Empty;

    protected override void OnParametersSet()
    {
        hourlyRateText = LaborModel?.HourlyRate.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? string.Empty;
        hoursText = LaborModel?.Hours.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? string.Empty;
    }

    async Task Save()
    {
        if (!string.IsNullOrWhiteSpace(hoursText))
        {
            if (decimal.TryParse(hoursText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.CurrentCulture, out var hrs))
            {
                LaborModel.Hours = hrs;
            }
            else
            {
                LaborModel.Hours = 0m;
            }
        }

        if (!string.IsNullOrWhiteSpace(hourlyRateText))
        {
            if (decimal.TryParse(hourlyRateText, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.CurrentCulture, out var rate))
            {
                LaborModel.HourlyRate = rate;
            }
            else
            {
                // If parse fails, set to 0 and allow validation to surface
                LaborModel.HourlyRate = 0m;
            }
        }

        await OnSave.InvokeAsync(LaborModel);
    }

}