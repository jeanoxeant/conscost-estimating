@using ConstructionCostEstimator.Models
@using ConstructionCostEstimator.Services

<EditForm Model="LaborModel" OnValidSubmit="Save" FormName="LaborForm">

    <DataAnnotationsValidator />

    <ValidationSummary />

    <div class="row">

        <div class="col-md-3 mb-3">
            <label class="form-label">Description</label>
            <InputText class="form-control"
                       @bind-Value="LaborModel.Description" />
            <ValidationMessage For="@(() => LaborModel.Description)" class="text-danger" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Workers</label>
            <InputNumber class="form-control"
                         @bind-Value="LaborModel.Workers" />
            <ValidationMessage For="@(() => LaborModel.Workers)" class="text-danger" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Hours</label>
            <InputNumber class="form-control"
                         @bind-Value="LaborModel.Hours" />
            <ValidationMessage For="@(() => LaborModel.Hours)" class="text-danger" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Hourly Rate</label>
            <InputNumber class="form-control"
                         @bind-Value="LaborModel.HourlyRate" />
            <ValidationMessage For="@(() => LaborModel.HourlyRate)" class="text-danger" />
        </div>

        <div class="col-md-2 d-grid">

            <label>&nbsp;</label>

            <button class="btn btn-success" type="submit">
                @(LaborModel.Id == 0 ? "Add Labor" : "Save Changes")
            </button>

        </div>

    </div>

</EditForm>

@code{

    [Parameter]
    public Labor LaborModel { get; set; } = new();

    [Parameter]
    public EventCallback<Labor> OnSave { get; set; }

    async Task Save()
    {
        await OnSave.InvokeAsync(LaborModel);
    }

}