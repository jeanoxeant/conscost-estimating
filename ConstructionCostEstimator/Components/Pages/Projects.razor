@page "/projects"
@rendermode InteractiveServer

@using ConstructionCostEstimator.Models
@using ConstructionCostEstimator.Services
@using ConstructionCostEstimator.Data

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject ProjectService ProjectService
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Projects</PageTitle>
<p>Show Form: @showForm</p>

<div class="projects-dashboard">

    <div class="projects-hero card border-0 shadow-sm">
        <div class="card-body p-4 p-lg-5">

            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center">

                <div>

                    <p class="text-uppercase fw-semibold mb-2 text-white-50">
                        Project Dashboard
                    </p>

                    <h1 class="display-6 fw-bold">
                        Manage your Construction Projects
                    </h1>

                    <p class="text-white-50 mb-0">
                        Track estimates, costs, schedules, and project progress.
                    </p>

                </div>
<!--
                <button class="btn btn-light text-primary fw-semibold mt-3 mt-lg-0"
                        @onclick="NavigateToCreate">

                    <i class="bi bi-plus-circle me-2"></i>

                    Create Project

                </button>
-->
            </div>

        </div>
    </div>

    <div class="row mt-4 g-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted">
                        Total Projects
                    </div>

                    <h2>@projects.Count</h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted">
                        Active Projects
                    </div>

                    <h2>@activeProjects</h2>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="text-muted">
                        Planned Projects
                    </div>

                    <h2>@plannedProjects</h2>

                </div>

            </div>

        </div>

    </div>

    <div class="mt-5">

        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>

                <h3>Projects</h3>

                <p class="text-muted">
                    View and manage all construction projects.
                </p>

            </div>

        </div>

        @if (projects.Count == 0)
        {
            <div class="card shadow-sm">

                <div class="card-body text-center py-5">

                    <h4>No Projects Found</h4>

                    <p class="text-muted">
                        Create your first construction project.
                    </p>

                    <button class="btn btn-primary"
                            @onclick="NewProject">
                        Create New Project
                    </button>

                </div>

            </div>
        }
        else
        {
            <div class="row g-4">

                @foreach (var project in projects)
                {
                    <div class="col-lg-6">

                        <div class="card shadow-sm border-0 h-100">

                            <div class="card-body">

                                <div class="d-flex justify-content-between">

                                    <div>

                                        <span class="badge @GetStatusBadgeClass(project.Status)">
                                            @project.Status
                                        </span>

                                        <h4 class="mt-2">
                                            @project.Name
                                        </h4>

                                        <p class="text-muted">

                                            @(string.IsNullOrWhiteSpace(project.Description)
                                                ? "No description available."
                                                : project.Description)

                                        </p>

                                    </div>

                                    <span class="@GetStatusClass(project.Status)">
                                    </span>

                                </div>

                                <div class="row mt-3">

                                    <div class="col-6">

                                        <small class="text-muted">
                                            Estimated Cost
                                        </small>

                                        <h5>
                                            @project.EstimatedCost.ToString("C")
                                        </h5>

                                    </div>

                                    <div class="col-6">

                                        <small class="text-muted">
                                            Start Date
                                        </small>

                                        <h5>

                                            @(project.StartDate == default
                                                ? "TBD"
                                                : project.StartDate.ToShortDateString())

                                        </h5>

                                    </div>

                                </div>

                                <div class="mt-4 d-flex gap-2">

                                    <button class="btn btn-outline-primary btn-sm"
                                            @onclick="() => NavigateToEdit(project.Id)">

                                        Edit

                                    </button>

                                    <button class="btn btn-danger btn-sm"
                                            @onclick="() => ShowDeleteConfirmation(project)">

                                        Delete

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                }

            </div>
        }

    </div>
</div>

@if (selectedProject != null)
{
    <div class="card border-danger shadow-sm mt-4">

        <div class="card-header bg-danger text-white">
            Delete Project
        </div>

        <div class="card-body">

            <p>
                You are about to permanently delete
                <strong>@selectedProject.Name</strong>.
            </p>

            <p class="text-danger">
                This action cannot be undone.
            </p>

            <p>
                Type <strong>DELETE</strong> to confirm.
            </p>

            <InputText class="form-control"
                       @bind-Value="confirmationText" />

            <div class="mt-3">

                <button class="btn btn-danger"
                        disabled="@(confirmationText != "DELETE")"
                        @onclick="DeleteProject">

                    Delete Permanently

                </button>

                <button class="btn btn-secondary ms-2"
                        @onclick="CancelDelete">

                    Cancel

                </button>

            </div>

        </div>

    </div>
}

@if (showForm)
{
    <hr />

    <ProjectForm ProjectModel="currentProject"
                 OnSave="SaveProject" />
}

@code
{
    private List<Project> projects = new();

    private Project currentProject = new();

    private Project? selectedProject;

    private string confirmationText = "";

    private bool showForm = false;

    private int activeProjects =>
        projects.Count(p => p.Status == ProjectStatus.Active);

    private int plannedProjects =>
        projects.Count(p => p.Status == ProjectStatus.Planned);

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        var user =
            await UserManager.GetUserAsync(authState.User);

        if (user == null)
            return;

        projects = await Db.Projects
            .Where(p => p.ApplicationUserId == user.Id)
            .OrderBy(p => p.Name)
            .ToListAsync();
    }

    private void NewProject()
    {
        Console.WriteLine("Button clicked");

        currentProject = new Project();
        showForm = true;

        StateHasChanged();
    }

    private void EditProject(Project project)
    {
        currentProject = new Project
        {
            Id = project.Id,
            Name = project.Name,
            Description = project.Description,
            EstimatedCost = project.EstimatedCost,
            StartDate = project.StartDate,
            EndDate = project.EndDate,
            Status = project.Status,
            ApplicationUserId = project.ApplicationUserId
        };

        showForm = true;
    }

    private async Task SaveProject(Project project)
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user == null)
        {
            // User is not logged in.
            return;
        }

        project.ApplicationUserId = user.Id;

        if (project.Id == 0)
            await ProjectService.AddProjectAsync(project);
        else
            await ProjectService.UpdateProjectAsync(project);

        showForm = false;
        currentProject = new Project();

        await LoadProjects();
    }

    private void NavigateToCreate()
    {
        Navigation.NavigateTo("/projects/create");
    }

    private void NavigateToEdit(int projectId)
    {
        Navigation.NavigateTo($"/projects/edit/{projectId}");
    }

    private void ShowDeleteConfirmation(Project project)
    {
        selectedProject = project;
        confirmationText = "";
    }

    private void CancelDelete()
    {
        selectedProject = null;
        confirmationText = "";
    }

    private async Task DeleteProject(int id)
    {
        await ProjectService.DeleteProjectAsync(id);
        await LoadProjects();
    }

    private async Task DeleteProject()
    {
        if (selectedProject == null)
            return;

        if (confirmationText != "DELETE")
            return;

        var project = await Db.Projects.FirstOrDefaultAsync(p =>
            p.Id == selectedProject.Id &&
            p.ApplicationUserId == selectedProject.ApplicationUserId);

        if (project == null)
            return;

        Db.Projects.Remove(project);

        await Db.SaveChangesAsync();

        await LoadProjects();

        selectedProject = null;
        confirmationText = "";
    }

    private string GetStatusBadgeClass(ProjectStatus status) => status switch
    {
        ProjectStatus.Active => "bg-primary",
        ProjectStatus.Completed => "bg-success",
        ProjectStatus.OnHold => "bg-warning text-dark",
        ProjectStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    private string GetStatusClass(ProjectStatus status) => status switch
    {
        ProjectStatus.Active => "status-active",
        ProjectStatus.Completed => "status-completed",
        ProjectStatus.OnHold => "status-onhold",
        ProjectStatus.Cancelled => "status-cancelled",
        _ => "status-planned"
    };
}

