@page "/dashboard"
@rendermode InteractiveServer

@using ConstructionCostEstimator.Data
@using ConstructionCostEstimator.Models
@using ConstructionCostEstimator.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject ProjectService ProjectService
@inject ApplicationDbContext Db
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation

<PageTitle>Dashboard</PageTitle>

<h3 class="mb-4">Construction Cost Estimator Dashboard</h3>

@if (loading)
{
    <p><em>Loading dashboard...</em></p>
}
else
{
    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h5>Total Projects</h5>
                    <h2>@TotalProjects</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h5>Total Estimated Cost</h5>
                    <h2>@TotalEstimatedCost.ToString("C")</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h5>Active Projects</h5>
                    <h2>@ActiveProjects</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card text-center shadow">
                <div class="card-body">
                    <h5>Completed Projects</h5>
                    <h2>@CompletedProjects</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow">

        <div class="card-header">
            <strong>Recent Projects</strong>
        </div>

        <div class="card-body">

            @if (Projects.Count == 0)
            {
                <p>No projects found.</p>
            }
            else
            {
                <table class="table table-striped">

                    <thead>

                        <tr>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Estimated Cost</th>
                            <th>Start</th>
                            <th>End</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var project in Projects)
                        {
                            <tr>
                                <td>@project.Name</td>
                                <td>@project.Description</td>
                                <td>@project.Status</td>
                                <td>@GetProjectEstimate(project)</td>
                                <td>@project.StartDate?.ToShortDateString()</td>
                                <td>@project.EndDate?.ToShortDateString()</td>
                            </tr>
                        }

                    </tbody>

                </table>
            }

        </div>

    </div>
}

@code
{
    private bool loading = true;

    private List<Project> Projects = new();

    private int TotalProjects;

    private int ActiveProjects;

    private int CompletedProjects;

    private decimal TotalEstimatedCost;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);

        if (user is null)
        {
            Navigation.NavigateTo("/Account/Login", forceLoad: true);
            loading = false;
            return;
        }

        Projects = await Db.Projects
            .Where(p => p.ApplicationUserId == user.Id)
            .Include(p => p.ProjectMaterials)
            .Include(p => p.ProjectLabors)
            .OrderByDescending(p => p.StartDate)
            .ToListAsync();

        TotalProjects = Projects.Count;

        decimal totalEstimatedCost = 0;
        foreach (var project in Projects)
        {
            totalEstimatedCost += GetProjectEstimateValue(project);
        }

        TotalEstimatedCost = totalEstimatedCost;
        ActiveProjects = Projects.Count(p => p.Status == ProjectStatus.Active);
        CompletedProjects = Projects.Count(p => p.Status == ProjectStatus.Completed);

        loading = false;
    }

    private string GetProjectEstimate(Project project)
    {
        var estimateValue = GetProjectEstimateValue(project);
        return estimateValue.ToString("C");
    }

    private decimal GetProjectEstimateValue(Project project)
    {
        var materialCost = project.ProjectMaterials.Sum(m => m.TotalCost);
        var laborCost = project.ProjectLabors.Sum(l => l.RatePerHour * l.Hours);
        var equipmentCost = Db.Equipment
            .Where(e => e.ProjectId == project.Id)
            .Sum(e => e.Days * e.DailyRate);
        return materialCost + laborCost + equipmentCost;
    }
}