    private async Task DownloadReport(ProjectReport report)
    {
        var pdf = PdfService.GenerateProjectReport(report);

        await JS.InvokeVoidAsync(
        "downloadFile",
        $"{report.ProjectName}.pdf",
        Convert.ToBase64String(pdf));
    }
