@using ConstructionCostEstimator.Models

<EditForm Model="EquipmentModel" OnValidSubmit="Save" FormName="equipment-form" id="equipment-form">

    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="row g-3 align-items-end">

        <div class="col-md-4">
            <label class="form-label">Equipment</label>
            <InputText class="form-control"
                       @bind-Value="EquipmentModel.Name" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Days</label>
            <InputNumber class="form-control"
                         @bind-Value="EquipmentModel.Days" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Daily Rate</label>
            <InputNumber class="form-control"
                         @bind-Value="EquipmentModel.DailyRate" />
        </div>

        <div class="col-md-3 d-grid">
            <button class="btn btn-success" type="submit" form="equipment-form">
                Save Equipment
            </button>
        </div>

    </div>

    <div class="mt-3 text-muted small">
        Estimated total: @EquipmentTotal.ToString("C")
    </div>

</EditForm>

@code {

    [Parameter]
    public Equipment EquipmentModel { get; set; } = new();

    [Parameter]
    public EventCallback<Equipment> OnSave { get; set; }

    private decimal EquipmentTotal => EquipmentModel.Days * EquipmentModel.DailyRate;

    private async Task Save()
    {
        await OnSave.InvokeAsync(EquipmentModel);
    }

}